# Dependencies
node_modules/

# Environment — never commit real secrets
.env
.env.*
!.env.example
nginx/ssl/*.pem

# Server-specific Docker Compose overrides (e.g. port bindings per host)
docker-compose.override.yml

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Self-hosted ambient videos: large binaries live on the server, not in git.
# Upload them with scripts/upload-media.sh.
media/*
!media/README.md

# Build artifacts
dist/
build/
data/
