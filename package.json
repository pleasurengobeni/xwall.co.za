{
  "name": "xwall",
  "version": "1.0.0",
  "description": "xwall.co.za — Ambient wallpaper & personal playlist display",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' jest --forceExit",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' jest --watch --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "routes/**/*.js",
      "config/**/*.js",
      "public/js/**/*.js"
    ]
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-spotify": "^2.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
