# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgresql://xwall:replace_with_a_long_random_database_password@db:5432/xwall

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── Google OAuth (YouTube) ───────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://xwall.co.za/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://xwall.co.za/auth/google/callback

# Restrict to YouTube Data API v3 and your production referrer/domain only.
GOOGLE_API_KEY=replace_with_a_restricted_youtube_data_api_key

# ── Admin Dashboard ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ── Spotify OAuth ────────────────────────────────────────────────────────────
# Create app at: https://developer.spotify.com/dashboard
# Redirect URI to register: https://xwall.co.za/auth/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=https://xwall.co.za/auth/spotify/callback
