# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgresql://xwall:replace_with_a_long_random_database_password@db:5432/xwall

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── Google OAuth (YouTube) ───────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://xwall.co.za/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://xwall.co.za/auth/google/callback

# No server-side API key is used: playlist search and ambient video suggestions
# run on the signed-in user's own OAuth token, and visitors who are not signed
# in get the bundled ambience list. If you previously set GOOGLE_API_KEY, it is
# no longer read — delete the key in Google Cloud Console.

# Safety cap on searches per signed-in account per day (default 15). The
# YouTube project affords ~100 uncached searches a day in total (10,000 units
# at 100 each), so this stops one account spending everyone's. Repeat searches
# are served from a 24 h shared cache, and Spotify searches cost no quota.
SEARCH_LIMIT_PER_DAY=15

# ── Admin Dashboard ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ── Spotify OAuth ────────────────────────────────────────────────────────────
# Create app at: https://developer.spotify.com/dashboard
# Redirect URI to register: https://xwall.co.za/auth/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=https://xwall.co.za/auth/spotify/callback
